# HuggingFace token — required only if datasets are gated
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OCR endpoint — only needed if re-running OCR (not required for reproduction)
# Users using the cached artifacts from download_data.sh do NOT need this.
# OCR_ENDPOINT_URL=http://your-vllm-server:9000/v1
# OCR_API_KEY=EMPTY
# OCR_MODEL_NAME=Qwen/Qwen3.5-122B-A10B
